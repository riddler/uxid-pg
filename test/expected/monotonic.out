SELECT uxid_monotonic(NULL, 'm', time_ms => 1700000000000) AS no_prefix_id
\gset
SELECT uxid_monotonic('', 'm', time_ms => 1700000000000) AS empty_prefix_id
\gset
SELECT
    pg_temp.state('uxid.mono_646f63_2') ~ '^1700000000000:' AS own_prefix_state,
    pg_temp.state('uxid.mono_757372_4') ~ '^1700000000000:' AS own_width_state,
    pg_temp.state('uxid.mono_757372_3') ~ '^1700000000000:'
        AS own_compact_state,
    pg_temp.state('uxid.mono__5') ~ '^170000000000[01]:' AS no_prefix_state,
    :'empty_prefix_id' COLLATE "C" > :'no_prefix_id' AS shared_state,
    uxid_encode(
        NULL,
        'm',
        split_part(pg_temp.state('uxid.mono__5'), ':', 1)::bigint,
        uxid__numeric_bytes(
            split_part(pg_temp.state('uxid.mono__5'), ':', 2)::numeric, 5
        )
    ) = :'empty_prefix_id' AS state_is_last_id,
    :'empty_prefix_id' ~ '^[0-9a-hjkmnp-tv-z]{18}$' AS bare_body;
 own_prefix_state | own_width_state | own_compact_state | no_prefix_state | shared_state | state_is_last_id | bare_body 
------------------+-----------------+-------------------+-----------------+--------------+------------------+-----------
 t                | t               | t                 | t               | t            | t                | t
(1 row)

SELECT
    uxid_monotonic('caf' || chr(233), 'xs', time_ms => 1700000000000)
    ~ ('^caf' || chr(233) || '_[0-9a-hjkmnp-tv-z]{10}$') AS accented_id,
    pg_temp.state('uxid.mono_636166c3a9_1') ~ '^1700000000000:'
        AS accented_state,
    uxid_monotonic(repeat('p', 200), 'xs', time_ms => 1700000000000)
    ~ '^p{200}_' AS long_prefix_id;
 accented_id | accented_state | long_prefix_id 
-------------+----------------+----------------

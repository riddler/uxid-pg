-- The state is transactional: a transaction that aborts, and a savepoint
-- rolled back, restore the state they found, so the ids returned inside
-- them may repeat in this session.
-- No mutation of the extension turns these rows red: they pin
-- PostgreSQL's own rule, which the generator's documentation states.
SELECT set_config('uxid.mono_757372_2', '1700000000000:100', FALSE);
    set_config     
-------------------
 1700000000000:100
(1 row)

BEGIN;
SELECT uxid_monotonic('usr', 's', time_ms => 1700000000000) ~ '^usr_'
    AS inside_transaction;
 inside_transaction 
--------------------
 t
(1 row)

SELECT pg_temp.state('uxid.mono_757372_2') <> '1700000000000:100'
    AS changed_inside;
 changed_inside 
----------------
 t
(1 row)

ROLLBACK;
SELECT pg_temp.state('uxid.mono_757372_2') AS after_rollback;
  after_rollback   
-------------------
 1700000000000:100
(1 row)

-- A PL/pgSQL block with an exception handler runs in a savepoint: an id
-- generated in it and the error that rolls it back leave the state as
-- the block found it.
DO $savepoint$
BEGIN
    BEGIN
        PERFORM uxid_monotonic('usr', 's', time_ms => 1700000000000);
        RAISE EXCEPTION 'roll the savepoint back';
    EXCEPTION WHEN raise_exception THEN
        NULL;
    END;
END;
$savepoint$;
SELECT pg_temp.state('uxid.mono_757372_2') AS after_savepoint_rollback;
 after_savepoint_rollback 
--------------------------
 1700000000000:100
(1 row)

BEGIN;
SELECT uxid_monotonic('newer', 's', time_ms => 1700000000000) ~ '^newer_'
    AS first_in_transaction;
 first_in_transaction 
----------------------
 t
(1 row)

ROLLBACK;
SELECT coalesce(pg_temp.state('uxid.mono_6e65776572_2'), '') = ''
    AS no_state_after_rollback;

-- uxid_monotonic: the monotonic generator, its state in a session
-- setting per prefix and random width, and what a refusal, a rollback and
-- a reset do to that state.
\set SHOW_CONTEXT never
-- The state of one generator: its session setting, or NULL when this
-- session has no such setting (the empty string after a reset).
CREATE FUNCTION pg_temp.state(setting_name text)
RETURNS text
LANGUAGE sql
AS $state$
    SELECT current_setting(setting_name, TRUE);
$state$;
-- With no state, the first id carries the given time and a fresh random
-- field, and the state is written under uxid.mono_<hex of the prefix>_
-- <width> as "<time>:<value>": here usr is 757372 and an s id's field is
-- 2 bytes. The id is the state's time and value through the encoder.
-- sabotage: coalesce(prefix, '') in place of the hex of the prefix's
-- bytes in the setting name -> "ERROR:  uxid: invalid_argument:
-- uxid_encode needs a time_ms" (id_from_state finds no state)
-- sabotage: TRUE in place of FALSE as set_config's is_local in
-- uxid_monotonic -> "ERROR:  invalid input syntax for type bigint: """
-- (the state is gone after the statement)
SELECT pg_temp.state('uxid.mono_757372_2') IS NULL AS no_state_yet;
 no_state_yet 
--------------
 t
(1 row)

SELECT uxid_monotonic('usr', 's', time_ms => 1700000000000) AS first_id
\gset
SELECT
    pg_temp.state('uxid.mono_757372_2') ~ '^1700000000000:[0-9]+$'
        AS state_shape,
    uxid_encode(
        'usr',
        's',
        split_part(pg_temp.state('uxid.mono_757372_2'), ':', 1)::bigint,
        uxid__numeric_bytes(
            split_part(pg_temp.state('uxid.mono_757372_2'), ':', 2)::numeric, 2
        )
    ) = :'first_id' AS id_from_state;
 state_shape | id_from_state 
-------------+---------------
 t           | t
(1 row)

-- At one time, every later id carries that time and sorts strictly after
-- the one before it, within one statement and across statements; each
-- value is the last plus a step from 1 to 2^(4w) (here 1 to 256), or,
-- when that would overflow the field, the next millisecond with a fresh
-- value.
-- sabotage: req.now_ms in place of st.time_ms as uxid_encode's time in
-- uxid_monotonic -> " 300 |          300 | f                   | t ..."
-- (strictly_increasing false: an overflowed id carries the clock's
-- millisecond)
CREATE TEMPORARY TABLE burst (n integer, id text, state text);
DO $burst$
BEGIN
    FOR i IN 1 .. 300 LOOP
        INSERT INTO burst (n, id, state)
        SELECT
            i,
            uxid_monotonic('usr', 's', time_ms => 1700000000000),
            NULL;
        UPDATE burst SET state = pg_temp.state('uxid.mono_757372_2')
        WHERE n = i;
    END LOOP;
END;
$burst$;
WITH
steps AS (
    SELECT
        b.n,
        b.id,
        lag(b.id) OVER (ORDER BY b.n) AS previous_id,
        split_part(b.state, ':', 1)::bigint AS state_time,
        split_part(b.state, ':', 2)::numeric AS state_value,
        lag(split_part(b.state, ':', 1)::bigint) OVER (ORDER BY b.n)
            AS previous_time,
        lag(split_part(b.state, ':', 2)::numeric) OVER (ORDER BY b.n)
            AS previous_value
    FROM burst AS b
)
SELECT
    count(*) AS ids,
    count(DISTINCT s.id) AS distinct_ids,
    bool_and(s.previous_id IS NULL OR s.id::uxid > s.previous_id::uxid)
        AS strictly_increasing,
    bool_and(
        s.previous_time IS NULL
        OR (
            s.state_time = s.previous_time
            AND s.state_value - s.previous_value BETWEEN 1 AND 256
        )
        OR (
            s.state_time = s.previous_time + 1
            AND s.previous_value + 256 >= 65536
        )
    ) AS every_step_in_range,
    min(s.state_time) >= 1700000000000
    AND max(s.state_time) < 1700000000010 AS within_ten_ms
FROM steps AS s;
 ids | distinct_ids | strictly_increasing | every_step_in_range | within_ten_ms 
-----+--------------+---------------------+---------------------+---------------
 300 |          300 | t                   | t                   | t
(1 row)

-- One statement that calls the generator many times sees each call's
-- state: the ids are distinct and in order.
SELECT
    count(DISTINCT g.id) AS distinct_ids,
    bool_and(g.id::uxid > g.previous_id::uxid) FILTER (
        WHERE g.previous_id IS NOT NULL
    ) AS strictly_increasing
FROM
    (
        SELECT
            q.id,
            lag(q.id) OVER (ORDER BY q.n) AS previous_id
        FROM
            (
                SELECT
                    s.n,
                    uxid_monotonic('doc', 'l', time_ms => 1700000000000) AS id
                FROM generate_series(1, 50) AS s (n)
            ) AS q
    ) AS g;
 distinct_ids | strictly_increasing 
--------------+---------------------
           50 | t
(1 row)

-- A clock that moves back keeps the last time; a later clock starts a
-- fresh value at that time. An xl field is 80 bits and a step at most
-- 2^40, so these steps never overflow.
-- sabotage: now_ms > last_time_ms changed to now_ms <> last_time_ms in
-- uxid__monotonic_rule -> " 1699999999000" under back_time
SELECT uxid_monotonic('item', time_ms => 1700000000000) ~ '^item_'
    AS item_id;
 item_id 
---------
 t
(1 row)

SELECT d.time_ms AS back_time
FROM
    uxid_decode_at(
        uxid_monotonic('item', time_ms => 1699999999000), 1700000000000
    ) AS d;
   back_time   
---------------
 1700000000000
(1 row)

SELECT d.time_ms AS later_time
FROM
    uxid_decode_at(
        uxid_monotonic('item', time_ms => 1700000005000), 1700000000000
    ) AS d;
  later_time   
---------------
 1700000005000
(1 row)

SELECT split_part(pg_temp.state('uxid.mono_6974656d_10'), ':', 1) AS state_time;
  state_time   
---------------
 1700000005000
(1 row)

-- With no time_ms the time is the clock's (clock_timestamp()).
SELECT
    abs(
        d.time_ms - floor(extract(EPOCH FROM clock_timestamp()) * 1000)
    ) < 60000 AS clock_time
FROM uxid_decode(uxid_monotonic('item', 'm')) AS d;
 clock_time 
------------
 t
(1 row)

-- One state per prefix and per random width: another prefix, another
-- rand_size and another time form each have their own setting; NULL and
-- the empty string are both no prefix and share one; the prefix is hex of
-- its UTF-8 bytes, so any prefix makes a setting name.
-- sabotage: drop the "_" || width part of the setting name ->
-- "ERROR:  uxid: invalid_argument: uxid_encode needs a time_ms" at the
-- first state read, and " f" rows below
SELECT uxid_monotonic('doc', 's', time_ms => 1700000000000) ~ '^doc_'
    AS doc_id;
 doc_id 

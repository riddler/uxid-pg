-- The generator is volatile and parallel unsafe: its state is the
-- session's, which a parallel worker could not write.
-- sabotage: PARALLEL SAFE in place of PARALLEL UNSAFE on uxid_monotonic
-- -> " v           | s           | text" here
SELECT
    p.provolatile,
    p.proparallel,
    pg_get_function_result(p.oid) AS result
FROM pg_proc AS p
WHERE p.proname = 'uxid_monotonic';
 provolatile | proparallel | result 
-------------+-------------+--------
 v           | u           | text
(1 row)


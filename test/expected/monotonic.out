-- An xs always uses compact time, so its field has 1 byte to step: with
-- no time form given or compact true it is a compact xs (10 characters,
-- the time at the given millisecond or, after an overflow of its 1-byte
-- field, one of the next two);
-- an explicit compact false is refused, with or without a rand_size.
-- Upper case and another delimiter work as for uxid_generate.
-- sabotage: AND req.width = 0 added to the monotonic xs condition in
-- uxid_check_request -> " xs, compact false, rand_size 1 | accepted"
CREATE FUNCTION pg_temp.refusal(statement text)
RETURNS text
LANGUAGE plpgsql
AS $refusal$
DECLARE
    state text;
    message text;
BEGIN
    EXECUTE statement;
    RETURN 'accepted';
EXCEPTION WHEN OTHERS THEN
    GET STACKED DIAGNOSTICS
        state = RETURNED_SQLSTATE,
        message = MESSAGE_TEXT;
    RETURN state || ' ' || message;
END;
$refusal$;
SELECT
    uxid_monotonic('usr', 'xs', time_ms => 1700000000000)
    ~ '^usr_hf7yat0[0-2][0-9a-hjkmnp-tv-z]{2}$' AS xs_default,
    uxid_monotonic('usr', 'xs', TRUE, time_ms => 1700000000000)
    ~ '^usr_hf7yat0[0-2][0-9a-hjkmnp-tv-z]{2}$' AS xs_compact,
    uxid_monotonic(
        'usr', 'xsmall', letter_case => 'upper', delimiter => '-',
        time_ms => 1700000000000
    ) ~ '^usr-HF7YAT0[0-2][0-9A-HJKMNP-TV-Z]{2}$' AS xs_upper;
 xs_default | xs_compact | xs_upper 
------------+------------+----------
 t          | t          | t
(1 row)

-- The refusals: as uxid_check_request refuses a monotonic request. The
-- generator takes no key and no fixed random field; uxid_check_request
-- refuses those as from_with_monotonic and rand_with_monotonic (the
-- corpus's cases, in check_request).
SELECT
    c.request,
    pg_temp.refusal(c.statement) AS refusal
FROM
    (
        VALUES
        (
            1,
            'xs, compact false',
            $s$SELECT uxid_monotonic('usr', 'xs', FALSE)$s$
        ),
        (
            2,
            'xs, compact false, rand_size 1',
            $s$SELECT uxid_monotonic('usr', 'xs', FALSE, 1)$s$
        ),
        (
            3,
            'rand_size 0',
            $s$SELECT uxid_monotonic('usr', 's', rand_size => 0)$s$
        ),
        (
            4,
            'rand_size 11',
            $s$SELECT uxid_monotonic('usr', rand_size => 11)$s$
        ),
        (
            5,
            'unknown size',
            $s$SELECT uxid_monotonic('usr', 'huge')$s$
        ),
        (
            6,
            'empty delimiter',
            $s$SELECT uxid_monotonic('usr', delimiter => '')$s$
        ),
        (
            7,
            'time past 2^48 - 1',
            $s$SELECT uxid_monotonic('usr', time_ms => 281474976710656)$s$
        ),
        (
            8,
            'compact time at the guard',
            $s$SELECT uxid_monotonic('usr', 's', TRUE,
            time_ms => 2164663517184)$s$
        ),
        (
            9,
            'from_with_monotonic',
            $s$SELECT uxid_check_request(prefix => 'usr',
            from_key => 'alice@example.com', monotonic => TRUE)$s$
        ),
        (
            10,
            'rand_with_monotonic',
            $s$SELECT uxid_check_request(prefix => 'usr', size => 's',
            rand => '\x0102', monotonic => TRUE)$s$
        )
    ) AS c (n, request, statement)
ORDER BY c.n;
            request             |                                                               refusal                                                                
--------------------------------+--------------------------------------------------------------------------------------------------------------------------------------
 xs, compact false              | 22023 uxid: invalid_argument: a monotonic xs uses compact time, so its random field has a byte to step; compact must be NULL or true
 xs, compact false, rand_size 1 | 22023 uxid: invalid_argument: a monotonic xs uses compact time, so its random field has a byte to step; compact must be NULL or true
 rand_size 0                    | 22023 uxid: invalid_argument: monotonic generation needs a random field; an xs with standard time or a rand_size of 0 has none
 rand_size 11                   | 22023 uxid: rand_size_too_large: rand_size must be at most 10; got 11
 unknown size                   | 22023 uxid: invalid_argument: size must be xs, s, m, l or xl (or xsmall, small, medium, large or xlarge); got 'huge'
 empty delimiter                | 22023 uxid: invalid_argument: delimiter must not be empty
 time past 2^48 - 1             | 22023 uxid: invalid_argument: time_ms must be from 0 to 281474976710655; got 281474976710656
 compact time at the guard      | 22023 uxid: compact_time_out_of_range: the compact time of 2164663517184 would start with the deterministic marker
 from_with_monotonic            | 22023 uxid: from_with_monotonic: a deterministic id is not generated monotonically
 rand_with_monotonic            | 22023 uxid: rand_with_monotonic: monotonic generation fills the random field itself
(10 rows)

-- A refused call leaves the state as it was. Each refusal below is its
-- own statement, so it aborts its own transaction with no savepoint: one
-- refused by the request check before anything is read, one refused by
-- the encoder after the step (the next millisecond, 2^48, is past the
-- time range) and one at the compact guard (the next millisecond's
-- compact time would start with the deterministic marker). No setting is
-- written for a refused request that had no state.
-- PostgreSQL undoes a setting written in a statement that fails, and the
-- generator writes its state only after the encoder has accepted the id.
-- sabotage: req.now_ms in place of st.time_ms as uxid_encode's time in
-- uxid_monotonic (the id no longer carries the step's time, so the
-- encoder never sees 2^48) -> " 281474976710656:..." under
-- after_time_refusal
SELECT set_config('uxid.mono_757372_2', '281474976710655:65535', FALSE);
      set_config       
-----------------------
 281474976710655:65535
(1 row)

SELECT uxid_monotonic('usr', 's', time_ms => 281474976710655);
ERROR:  uxid: invalid_argument: time_ms must be from 0 to 281474976710655; got 281474976710656
SELECT pg_temp.state('uxid.mono_757372_2') AS after_time_refusal;
  after_time_refusal   
-----------------------
 281474976710655:65535
(1 row)

SELECT uxid_monotonic('usr', 's', rand_size => 11);
ERROR:  uxid: rand_size_too_large: rand_size must be at most 10; got 11
SELECT pg_temp.state('uxid.mono_757372_2') AS after_check_refusal;
  after_check_refusal  
-----------------------
 281474976710655:65535
(1 row)

SELECT set_config('uxid.mono_757372_3', '2164663517183:16777215', FALSE);
       set_config       
------------------------
 2164663517183:16777215
(1 row)

SELECT uxid_monotonic('usr', 's', TRUE, time_ms => 2164663517183);
ERROR:  uxid: compact_time_out_of_range: the compact time of 2164663517184 would start with the deterministic marker
SELECT pg_temp.state('uxid.mono_757372_3') AS after_guard_refusal;
  after_guard_refusal   
------------------------
 2164663517183:16777215
(1 row)

-- The compact guard applies to the time the id carries, never to a clock
-- the id does not carry: with state at 1700000000000, a clock moved back
-- to 1065151889408 (whose compact time would start with the
-- deterministic marker) gives an id at the last time, its value stepped
-- by 1 to 2^(4w) (here 1 to 4096), as the second rule says.
-- sabotage: time_ms => time_ms in place of the CASE that passes an
-- in-range time as 0 in uxid_monotonic's first statement -> "ERROR:
-- uxid: compact_time_out_of_range: the compact time of 1065151889408
-- would start with the deterministic marker"
SELECT set_config('uxid.mono_757372_3', '1700000000000:100', FALSE);
    set_config     
-------------------
 1700000000000:100
(1 row)


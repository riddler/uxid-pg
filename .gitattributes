# pg_regress expected output is psql output byte for byte, which pads a
# column header with a trailing space; whitespace checks skip these files.
test/expected/*.out -whitespace

# The vendored conformance corpus is byte-exact: a checkout never converts
# its line endings, so the corpus hash holds on every platform.
conformance/** -text

# The release tarball is `git archive` of the tag (.github/workflows/release.yml),
# which leaves out every path marked export-ignore here. It holds the
# extension (uxid.control, uxid--*.sql), its build file (Makefile), the
# tests (test/, so a user can run `make installcheck`), the corpus and its
# check (conformance/, scripts/), docs/, LICENSE, README.md and
# CHANGELOG.md. It leaves out the repository's own tooling: the tracker,
# the agent instructions and settings, the CI and release workflows, the
# gate's tool pins, its Docker image and its lint settings, the changelog
# fragments, and the git files. None of the install paths in README.md
# uses them.
/.beads export-ignore
/.claude export-ignore
/.github export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/changelog.d export-ignore
/docker export-ignore
/mise.toml export-ignore
/.sqlfluff export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
